{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSize",
  "mainBinaryName": "FileSize",
  "version": "0.1.0",
  "identifier": "com.joel.filesize",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FileSize",
        "width": 1180,
        "height": 760,
        "minWidth": 520,
        "transparent": true,
        "center": true,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Joel Florian",
    "shortDescription": "Analizador de espacio en disco",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
